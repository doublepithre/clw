{
  "name": "resumeai-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "workers": "tsx src/workers/index.ts",
    "workers:build": "node dist/workers/index.js",
    "migrate": "node-pg-migrate --migration-file-language ts --migrations-dir migrations up",
    "migrate:create": "node-pg-migrate --migration-file-language ts --migrations-dir migrations create",
    "migrate:down": "node-pg-migrate --migration-file-language ts --migrations-dir migrations down",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/aiplatform": "^3.30.0",
    "@google-cloud/storage": "^7.14.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.25.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "officeparser": "^5.1.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.0",
    "rate-limit-redis": "^4.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "node-pg-migrate": "^7.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
